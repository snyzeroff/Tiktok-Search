# Dossier où sont stockés la base SQLite et les fichiers temporaires
TTS_DATA_DIR=./data

# Transcription : "auto" (sous-titres TikTok puis Whisper local si installé), "subtitles" (sous-titres seuls), "off"
TTS_TRANSCRIBE=auto
# Modèle faster-whisper : tiny, base, small, medium, large-v3
TTS_WHISPER_MODEL=small
# OCR du texte affiché à l'écran (nécessite tesseract + pytesseract)
TTS_OCR=off
TTS_OCR_LANG=fra+eng

# Connexion TikTok (Login Kit + Data Portability API) — https://developers.tiktok.com
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=http://localhost:8000/auth/tiktok/callback

# Conserver la vidéo téléchargée (lecture locale + saut aux timecodes 100 % fiable, mais prend de la place)
TTS_KEEP_VIDEO=off
# Pause entre deux vidéos (secondes) pour ne pas se faire bloquer par TikTok
TTS_REQUEST_DELAY=1.0
# Vidéos traitées en parallèle (1 à 8). 2 est un bon compromis vitesse / risque de blocage.
TTS_WORKERS=2

# --- Sécurité (utile seulement si le serveur est accessible depuis le réseau) ---
# Jeton d'accès : ouvre ensuite http://<hôte>:8000/?token=<jeton> une fois (un cookie est posé)
TTS_AUTH_TOKEN=
# Noms d'hôte autorisés en plus de localhost (séparés par des virgules), ex. : monpc.local,192.168.1.20
TTS_ALLOWED_HOSTS=

# --- Analyse IA ---
# "gemini" (gratuit dans la limite du palier gratuit : https://aistudio.google.com/apikey),
# "ollama" (local, gratuit, nécessite un modèle vision type qwen2.5vl), "none" (extraction locale seule)
TTS_LLM=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5vl:7b
# Nombre max de captures envoyées à l'IA en mode "screens"
TTS_MAX_SCREENS=8
